# .env.example — copy to .env and fill in your values before running.
# Never commit a filled-in .env file; it is listed in .gitignore.
#
# Required ──────────────────────────────────────────────────────────────────
DB2_DATABASE=MYDB
DB2_HOSTNAME=localhost
DB2_UID=db2inst1
DB2_PWD=changeme

# Optional ──────────────────────────────────────────────────────────────────
# TCP port (default 50000)
DB2_PORT=50000

# Set to SSL to enable encrypted transport (required for IBM Cloud / Db2 SaaS)
# DB2_SECURITY=SSL

# Pool settings
DB2_POOL_SIZE=5        # number of persistent connections in the pool (max 20)
DB2_POOL_TIMEOUT=30    # seconds to wait for a free connection before raising

# Windows Python 3.8+ only: absolute path to the clidriver /bin directory.
# Required when ibm_db cannot locate its DLL automatically on Windows.
# Example: IBM_DB_WIN_DLL_DIR=C:\Program Files\IBM\CLIDRIVER\bin
# IBM_DB_WIN_DLL_DIR=

# Override the bundled clidriver version or point to an installed DB2 client:
# IBM_DB_HOME=/opt/ibm/db2/V12.1
# CLIDRIVER_VERSION=v12.1.0
